		{
			"name": "Creación de score",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log(pm.response.text())",
							"let jsonData = JSON.parse(responseBody);",
							"",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"tests[\"Response has id\"] = jsonData.id !== undefined;",
							"tests[\"Response has createdAt\"] = jsonData.createdAt !== undefined;",
							"",
							"if(jsonData.id) {",
							"    pm.collectionVariables.set('SCORE_ID', jsonData.id);",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const offerId = pm.variables.replaceIn(\"{{$randomInt}}\");",
							"const offerAmount = pm.variables.replaceIn(\"{{$randomInt}}\");",
							"const bagCost = pm.variables.replaceIn(\"{{$randomInt}}\");",
							"const bagSize = 'MEDIUM';",
							"",
							"pm.collectionVariables.set('SCORE_OFFERID', offerId);",
							"pm.collectionVariables.set('SCORE_OFFERAMOUNT', bagCost);",
							"pm.collectionVariables.set('SCORE_BAGCOST', bagCost);",
							"pm.collectionVariables.set('SCORE_BAGSIZE', bagSize);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
