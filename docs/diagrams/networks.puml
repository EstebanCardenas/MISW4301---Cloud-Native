@startuml
skinparam shadowing false
skinparam rectangle {
    BackgroundColor White
    BorderColor Black
}
skinparam cloud {
    BackgroundColor #fff8dc
    BorderColor Black
}
skinparam frame {
    BackgroundColor White
    BorderColor Black
}
skinparam component {
    BackgroundColor White
    BorderColor Black
}

cloud "Internet" as internet

frame "K8s" {
    component "Ingress" as ingress
    internet ..> ingress

    frame "Node" {
        ' INGRESS -> NODE PORTS
        ingress ..> n1
        ingress ..> n2
        ingress ..> n3

        ' USERS NETWORK
        frame "users-network" #Green {
            component "users-app-service" <<Port: 80>> as usersAppService
            
            component "users-app" <<Port: 9000>> as usersAppPod {
              component "users_app" as usersApp
            }

            n1 --> usersAppService
            usersAppService --> usersAppPod
        }

        ' CREDIT CARDS NETWORK
        frame "credit-cards-network" #Green {
            component "credit-cards-app-service" <<Port: 80>> as creditCardsAppService
            component "credit-cards-app" <<Port: 9000>> as creditCardsAppPod {
                component "credit-cards-app" as creditCardsApp
            }

            n2 --> creditCardsAppService
            creditCardsAppService --> creditCardsAppPod
        }

        ' NOTIFICATION NETWORK
        frame "notification-network" #Green {
            component "notification-app-service" <<Port: 80>> as notificationAppService
            component "notification-app" <<Port: 9000>> as notificationAppPod {
                component "notification-app" as notificationApp
            }

            n3 --> notificationAppService
            notificationAppService --> notificationAppPod
        }
    }
}

component "db" as db

' CONSUMER NETWORK
frame "aws-network" #Green {
    component "consumer_app" as consumerApp
    component "SQS" as sqs

    consumerApp --> sqs
}

component "TrueNative" as TrueNative

consumerApp ..> ingress

usersApp --> db
creditCardsApp --> db

usersApp ..> TrueNative
creditCardsApp ..> TrueNative 

@enduml